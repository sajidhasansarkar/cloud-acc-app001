# --- Database (Neon PostgreSQL) ---
# Use the "pooled" connection string from Neon for DATABASE_URL,
# and the "direct"/unpooled connection string for DIRECT_URL (used by Prisma migrations).
# IMPORTANT: replace this placeholder with a real connection string in your local/deployment environment.
# If the previous example credential was ever used, rotate/revoke it in Neon immediately.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed script (used only by prisma/seed.ts to create the first ADMIN user) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Admin User"
SEED_ORG_NAME="Demo Organization"

# Phase 5A-1 document upload storage
# local | vercel-blob
# Use vercel-blob on Vercel. Create a PRIVATE Vercel Blob store and provide BLOB_READ_WRITE_TOKEN.
DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_PROVIDER=vercel-blob
DOCUMENT_STORAGE_LOCAL_DIR=.storage/documents
# BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Phase 4B-5 AI accounting review provider
# heuristic | openai
ACCOUNTING_AI_PROVIDER=heuristic
# Defaults to "accounting-review-v1" for heuristic, "gpt-4o-mini" for openai.
# Override to pin a specific OpenAI model, e.g. gpt-4o.
ACCOUNTING_AI_MODEL=accounting-review-v1
# Required only when ACCOUNTING_AI_PROVIDER=openai. Get a key from platform.openai.com.
# IMPORTANT: never commit a real key here — use your local/deployment env instead.
# OPENAI_API_KEY=replace-with-an-openai-api-key

# Phase 5A-2: metadata classification acceptance threshold (HIGH, MEDIUM, or LOW)
DOCUMENT_CLASSIFICATION_CONFIDENCE_THRESHOLD=MEDIUM

# Phase 5A-3 OCR provider. "none" | "tesseract-cli" (requires the tesseract binary) | "openai" (uses OPENAI_API_KEY, no local binary needed).
DOCUMENT_OCR_PROVIDER=none
# Optional command path when DOCUMENT_OCR_PROVIDER=tesseract-cli
DOCUMENT_OCR_TESSERACT_COMMAND=tesseract
# Optional OpenAI model override when DOCUMENT_OCR_PROVIDER=openai. Defaults to gpt-4o-mini.
DOCUMENT_OCR_OPENAI_MODEL=gpt-4o-mini

# Phase 5A-9: OpenAI document understanding (classification + transaction/statement
# extraction from extracted/OCR'd content). "heuristic" keeps the old regex-only
# normalization (bank-statement-shaped tables only; images are unsupported).
# "openai" is required for the workflow described in the project brief: OpenAI
# classifies the document and extracts transactions, including for images,
# invoices, receipts, and financial statements.
DOCUMENT_AI_PROVIDER=heuristic
# Requires OPENAI_API_KEY (see above) when DOCUMENT_AI_PROVIDER=openai.
DOCUMENT_AI_MODEL=gpt-4o-mini
# Used only for image documents understood directly via vision.
DOCUMENT_AI_VISION_MODEL=gpt-4o-mini

# Optional: rasterizes scanned/image-only PDF pages so they can be OCR'd.
# "poppler" requires the `pdftoppm` binary (poppler-utils) to be installed on
# the server; default "none" leaves scanned PDFs flagged with a clear warning
# instead of silently returning no text.
DOCUMENT_PDF_RASTERIZER=none
DOCUMENT_PDFTOPPM_COMMAND=pdftoppm
