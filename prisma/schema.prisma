// Accounting Platform — Phase 1 + Phase 2A + Phase 2B-1 + Phase 3A-1 + Phase
// 3B-1 schema
// Phase 1: auth, organizations, memberships, companies (foundation).
// Phase 2A: full company management + reusable country configuration.
// Phase 2B-1: fiscal year / accounting period foundation (backend only —
// no UI yet, that's Phase 2B-2).
// Phase 3A-1: chart of accounts database foundation (backend only — no UI
// yet). See the Account model below.
// Phase 3B-1: tax code database foundation (backend only — no UI yet). See
// the TaxCode model below. No tax calculation, filing, returns, AI tax
// decisions, account mapping, or journal entries yet — those belong to
// later phases.
// Do not add journal entries/transactions/ledger/AI models here yet —
// those belong to later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum GlobalRole {
  ADMIN
  ACCOUNTANT
  REVIEWER
  MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

// ONBOARDING is retained for backward compatibility with any Phase 1 records
// created before Phase 2A. New companies are created directly as ACTIVE or
// ARCHIVED per the Phase 2A spec; the Create/Edit forms only expose those two.
enum CompanyStatus {
  ACTIVE
  ONBOARDING
  ARCHIVED
}

// Shared by FiscalYear and AccountingPeriod. Journal entries don't exist yet
// (later phase), so LOCKED/CLOSED don't block anything today — the enum and
// the status-change functions are prepared now so that phase can just start
// checking them without a schema change.
enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// Mirrors the existing `periodFrequencySchema` (src/lib/validations.ts) and
// the `PeriodFrequency` type already used by the period-generation workflow
// (src/accounting/accounting-periods.ts). Reusing the same two values here
// — rather than a free-form string — means Company.defaultPeriodFrequency
// can never drift out of sync with what the generator actually accepts.
enum PeriodFrequency {
  MONTHLY
  QUARTERLY
}

// Chart of Accounts (Phase 3A-1). The five classic accounting classes.
// Deliberately just these five, fixed — this is standard accounting theory
// (every account rolls up into exactly one of these), not a business rule
// that changes over time, so an enum is the right (and DB-checked) tool
// here, unlike AccountSubtype below.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Tax Code database foundation (Phase 3B-1). The broad category of tax a
// TaxCode represents. Deliberately an enum, not a free-form string — unlike
// Account.subtype, this is a small, standard, DB-checkable vocabulary that
// every supported country's tax codes map onto (see the TaxCode model
// comment). OTHER exists as an escape hatch for a tax type not yet named
// here, so onboarding a new country never requires a schema change first.
enum TaxType {
  GST
  HST
  VAT
  SALES_TAX
  OTHER
}

// How a TaxCode's rate should be applied. This phase only stores the
// method — it does not implement the calculation itself (spec section 8).
//  - STANDARD_RATE: the code's `rate` applies normally.
//  - ZERO_RATE: taxable, but at 0% (e.g. many exports) — still reportable,
//    distinct from EXEMPT.
//  - EXEMPT: not subject to this tax at all.
//  - OUT_OF_SCOPE: outside the tax system entirely (e.g. some
//    non-business transactions).
enum CalculationMethod {
  STANDARD_RATE
  ZERO_RATE
  EXEMPT
  OUT_OF_SCOPE
}

// ------------------------------
// Auth / Identity
// ------------------------------

// A person who can sign in to the internal platform (staff/accountants only —
// clients never get a User record in this system).
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         GlobalRole @default(ACCOUNTANT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships Membership[]

  @@map("users")
}

// A tenant. All Companies and data must be scoped to an Organization so that
// two organizations can never see each other's data.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  companies   Company[]

  @@map("organizations")
}

// Join table: which users belong to which organization, and with what role
// *within that organization*. Keeping this separate from User.role allows a
// user's permissions to differ per organization later (e.g. an external
// reviewer who is ADMIN in one org and REVIEWER in another).
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           GlobalRole       @default(ACCOUNTANT)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ------------------------------
// Companies (client entities managed inside an Organization)
// ------------------------------

// A "Company" is a client business being bookkept by the organization.
// Clients never log in — this is purely for internal staff to manage.
model Company {
  id             String        @id @default(cuid())
  organizationId String

  // Business information
  legalName       String
  displayName     String
  businessNumber  String?
  address         String?
  city            String?
  stateProvince   String?
  postalCode      String?
  country         String // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU" — kept as a
  // plain code (in addition to the FK below) so filters/sorts/display never
  // require a join, and so the record stays meaningful even if the referenced
  // CountryConfiguration is later deactivated or removed.
  countryConfigurationId String?
  contactEmail           String?
  contactPhone           String?

  // Accounting basics
  currency String // ISO 4217, e.g. "CAD", "USD", "GBP", "AUD"
  status   CompanyStatus @default(ACTIVE)

  // Company Settings → Accounting (Phase 2B-2B-2). Purely a default that
  // pre-fills the frequency selector in the existing "Generate Periods"
  // dialog (src/components/fiscal-years/generate-periods-dialog.tsx) — it
  // does not itself generate anything and does not change how
  // generateAndCreateAccountingPeriods works. A user can still pick the
  // other frequency at generation time.
  defaultPeriodFrequency PeriodFrequency @default(MONTHLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  countryConfiguration CountryConfiguration? @relation(fields: [countryConfigurationId], references: [id])

  fiscalYears       FiscalYear[]
  accountingPeriods AccountingPeriod[]
  accounts          Account[]
  taxCodes          TaxCode[]

  @@index([organizationId])
  @@index([countryConfigurationId])
  @@map("companies")
}

// ------------------------------
// Chart of Accounts (Phase 3A-1 — database foundation only, no UI yet)
// ------------------------------

// A single ledger account belonging to a Company (e.g. "1000 Assets",
// "1210 Bank Account A"). This phase only establishes the model, its
// hierarchy, and its constraints — no journal entries, balances, or
// automatic accounting logic post to it yet.
model Account {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?

  // Fixed top-level classification — see the AccountType enum comment.
  type AccountType

  // Finer classification within a type (e.g. "Bank", "Accounts Receivable"
  // under ASSET). Intentionally a plain string rather than an enum: the
  // spec explicitly asks for this not to be "unnecessarily rigid", and the
  // useful subtypes differ by company/industry/country in ways a fixed
  // enum can't accommodate without a migration every time. A curated list
  // of suggested subtypes per AccountType lives in
  // src/accounting/account-subtypes.ts for UI dropdowns to use — that list
  // is guidance, not a DB constraint.
  subtype String?

  // Self-referencing hierarchy: an account may have zero or one parent and
  // any number of children. Application code (src/accounting/accounts.ts)
  // is responsible for rejecting an account being its own parent and for
  // requiring the parent to belong to the same company — both are checks
  // that can't be expressed as a plain foreign key.
  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("AccountHierarchy")

  // Inactive accounts are hidden from normal selection lists but are never
  // deleted (accounting history must stay intact even once an account is
  // retired). No separate AccountStatus enum — a boolean is all this needs
  // and matches how the rest of this phase is scoped (no posting/balance
  // state to track yet).
  isActive Boolean @default(true)

  // Marks accounts the system itself relies on (e.g. Retained Earnings,
  // Opening Balance Equity, Accounts Receivable, Accounts Payable, Current
  // Year Earnings) so later phases can protect them from being renamed,
  // retyped, or deleted. No automatic accounting logic reads/writes this
  // flag yet in this phase — it's just persisted.
  isSystemAccount Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Account code must be unique within a company, but the same code (e.g.
  // "1000") is allowed to repeat across different companies.
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([parentAccountId])
  @@map("accounts")
}

// ------------------------------
// Fiscal Years / Accounting Periods (Phase 2B-1 — backend foundation only)
// ------------------------------

// A company's fiscal year (e.g. "FY2026", Apr 1 2026 → Mar 31 2027). A
// company can have many fiscal years over time, but a given company's
// fiscal years must never overlap in date range — enforced at the
// application level in src/accounting/fiscal-years.ts (see comments there).
model FiscalYear {
  id        String       @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  // A company shouldn't have two fiscal years with the same name (e.g. two
  // "FY2026"s). Overlap-by-date-range is a separate, non-unique-constraint
  // check performed in application code before create.
  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

// A subdivision of a FiscalYear (a month or a quarter, depending on how it
// was generated). companyId is denormalized from the parent FiscalYear
// (rather than derived via a join every time) so every query/index here can
// be scoped directly to a company — the same pattern Company already uses
// for organizationId. It is always set from the fiscal year's own
// companyId server-side, never taken from client input, so the two can
// never disagree.
model AccountingPeriod {
  id           String       @id @default(cuid())
  companyId    String
  fiscalYearId String
  name         String
  periodNumber Int
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  // Period numbers must be unique within a fiscal year (e.g. only one
  // "Period 1" per fiscal year).
  @@unique([fiscalYearId, periodNumber])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([companyId, startDate, endDate])
  @@map("accounting_periods")
}

// ------------------------------
// Supporting reference data (extendable, not hard-coded business logic)
// ------------------------------

// Reusable country configuration. Lets an ADMIN add supported countries later
// without a code change, and gives future phases (tax engine, fiscal periods,
// reporting) a single place to hang country-specific rules — none of which
// are implemented yet. Only the identity/currency fields are functional in
// Phase 2A; taxSystem / taxAuthority / accountingStandard / dateFormat are
// nullable placeholders for later phases.
model CountryConfiguration {
  id          String @id @default(cuid())
  countryName String
  countryCode String @unique // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU"

  currencyCode   String // ISO 4217, e.g. "CAD"
  currencySymbol String // e.g. "$"

  // Future-use fields — intentionally nullable, not implemented in Phase 2A.
  dateFormat         String?
  taxSystem          String?
  taxAuthority       String?
  accountingStandard String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]

  @@map("country_configurations")
}

// ------------------------------
// Tax Codes (Phase 3B-1 — database foundation only, no UI, no calculation
// engine yet)
// ------------------------------

// A single tax code belonging to a Company (e.g. "HST-ON" / 13% / HST for a
// Canadian company, or "STD" / 20% / VAT for a UK company). This phase only
// establishes the model and its constraints — no tax calculation, filing,
// returns, AI tax decisions, account mapping, or journal entries read/write
// it yet.
//
// countryCode is a plain ISO 3166-1 alpha-2 string (matching the pattern
// already used by Company.country) rather than a required FK to
// CountryConfiguration — the same country can have several tax regimes
// (e.g. Canada: federal GST plus per-province HST/PST), so "which country"
// and "which CountryConfiguration row is currently configured" are kept as
// separate concerns. No rates are seeded or hard-coded anywhere in this
// phase (spec section 5) — every TaxCode row is explicitly created with
// whatever rate/name/method the caller supplies. See
// src/tax/country-tax-guidance.ts for the (non-binding) suggested TaxType
// per supported country used to drive a future "add tax code" form.
model TaxCode {
  id        String @id @default(cuid())
  companyId String

  // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU" — see the model comment
  // above for why this isn't a required FK.
  countryCode String

  code String
  name String

  taxType           TaxType
  calculationMethod CalculationMethod

  // Percentage rate (e.g. 13.0000 for 13%), stored with enough precision
  // for real-world sub-percent tax rates. Application code (src/tax/tax-
  // codes.ts) enforces the one basic invariant this phase cares about —
  // ZERO_RATE/EXEMPT/OUT_OF_SCOPE codes must be 0, STANDARD_RATE codes must
  // be > 0 — but does not otherwise calculate or apply tax with it yet.
  rate Decimal @db.Decimal(7, 4)

  // Whether the tax this code represents can be recovered/claimed back as
  // an input tax credit (true for most GST/HST/VAT on business purchases,
  // typically false for e.g. US sales tax paid by the end consumer). Purely
  // descriptive metadata in this phase — nothing yet reads it to affect a
  // calculation.
  isRecoverable Boolean @default(true)

  // Inactive tax codes are hidden from normal selection lists but are never
  // deleted, same rationale as Account.isActive: historical transactions
  // that reference a tax code (once that exists in a later phase) must
  // keep working.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Tax code must be unique within a company, but the same code (e.g.
  // "STD") is allowed to repeat across different companies — same pattern
  // as Account.code.
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, countryCode])
  @@index([companyId, taxType])
  @@map("tax_codes")
}
