// Accounting Platform — Phase 1 + Phase 2A + Phase 2B-1 + Phase 3A-1 + Phase
// 3B-1 + Phase 3C-1 + Phase 4A-1 schema
// Phase 1: auth, organizations, memberships, companies (foundation).
// Phase 2A: full company management + reusable country configuration.
// Phase 2B-1: fiscal year / accounting period foundation (backend only —
// no UI yet, that's Phase 2B-2).
// Phase 3A-1: chart of accounts database foundation (backend only — no UI
// yet). See the Account model below.
// Phase 3B-1: tax code database foundation (backend only — no UI yet). See
// the TaxCode model below. No tax calculation, filing, returns, AI tax
// decisions, account mapping, or journal entries yet — those belong to
// later phases.
// Phase 3C-1: account mapping database foundation (backend only — no UI,
// no automatic matching yet). See the AccountMapping model below. This is
// only the reusable rule structure (source → Account / TaxCode) — nothing
// reads or applies these mappings to a real transaction yet, since
// transactions / bank import don't exist yet.
// Phase 4A-1: journal entry database foundation (backend only — no UI
// yet). See the JournalEntry / JournalEntryLine models below. Only basic
// DRAFT/POSTED/VOID status + balance/date validation exist — no automatic
// posting, numbering, file upload, OCR, AI extraction, bank import,
// general ledger, or financial reports yet. Those belong to later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum GlobalRole {
  ADMIN
  ACCOUNTANT
  REVIEWER
  MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

// ONBOARDING is retained for backward compatibility with any Phase 1 records
// created before Phase 2A. New companies are created directly as ACTIVE or
// ARCHIVED per the Phase 2A spec; the Create/Edit forms only expose those two.
enum CompanyStatus {
  ACTIVE
  ONBOARDING
  ARCHIVED
}

// Shared by FiscalYear and AccountingPeriod. Journal entries don't exist yet
// (later phase), so LOCKED/CLOSED don't block anything today — the enum and
// the status-change functions are prepared now so that phase can just start
// checking them without a schema change.
enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// Mirrors the existing `periodFrequencySchema` (src/lib/validations.ts) and
// the `PeriodFrequency` type already used by the period-generation workflow
// (src/accounting/accounting-periods.ts). Reusing the same two values here
// — rather than a free-form string — means Company.defaultPeriodFrequency
// can never drift out of sync with what the generator actually accepts.
enum PeriodFrequency {
  MONTHLY
  QUARTERLY
}

// Chart of Accounts (Phase 3A-1). The five classic accounting classes.
// Deliberately just these five, fixed — this is standard accounting theory
// (every account rolls up into exactly one of these), not a business rule
// that changes over time, so an enum is the right (and DB-checked) tool
// here, unlike AccountSubtype below.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Tax Code database foundation (Phase 3B-1). The broad category of tax a
// TaxCode represents. Deliberately an enum, not a free-form string — unlike
// Account.subtype, this is a small, standard, DB-checkable vocabulary that
// every supported country's tax codes map onto (see the TaxCode model
// comment). OTHER exists as an escape hatch for a tax type not yet named
// here, so onboarding a new country never requires a schema change first.
enum TaxType {
  GST
  HST
  VAT
  SALES_TAX
  OTHER
}

// How a TaxCode's rate should be applied. This phase only stores the
// method — it does not implement the calculation itself (spec section 8).
//  - STANDARD_RATE: the code's `rate` applies normally.
//  - ZERO_RATE: taxable, but at 0% (e.g. many exports) — still reportable,
//    distinct from EXEMPT.
//  - EXEMPT: not subject to this tax at all.
//  - OUT_OF_SCOPE: outside the tax system entirely (e.g. some
//    non-business transactions).
enum CalculationMethod {
  STANDARD_RATE
  ZERO_RATE
  EXEMPT
  OUT_OF_SCOPE
}

// Account Mapping database foundation (Phase 3C-1). What kind of source
// value an AccountMapping rule matches against (spec section 3). Purely a
// classification of the rule's input — no automatic matching engine reads
// this yet in this phase.
//  - BANK_DESCRIPTION: raw/normalized bank statement line text.
//  - VENDOR: a vendor/supplier name.
//  - CUSTOMER: a customer name.
//  - CATEGORY: a category label (e.g. from an import source).
//  - TRANSACTION_TYPE: a transaction's type/kind.
enum MappingSourceType {
  BANK_DESCRIPTION
  VENDOR
  CUSTOMER
  CATEGORY
  TRANSACTION_TYPE
}

// Journal Entry database foundation (Phase 4A-1). Lifecycle state of a
// journal entry (spec section 2).
//  - DRAFT: freely editable, not yet part of the books. Safe to hard-delete.
//  - POSTED: finalized. Never hard-deleted — see the JournalEntry model
//    comment and spec section 14. Reversed only by moving to VOID.
//  - VOID: cancelled/reversed. Terminal — nothing transitions out of VOID.
// Deliberately just these three today ("do not implement complex posting
// logic yet" — spec section 2), but kept as its own enum (rather than
// reusing PeriodStatus) since a journal entry's lifecycle is a different
// concept from a period's open/closed/locked state, even though both will
// eventually interact once real posting logic exists.
enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

// Journal Entry database foundation (Phase 4A-1). Where a journal entry
// originated (spec section 3) — purely descriptive metadata in this phase;
// nothing here implements import, bank feed, or AI extraction yet.
//  - MANUAL: entered directly by a user.
//  - IMPORT: brought in from a file (CSV/Excel/etc. — not implemented yet).
//  - AI: produced by AI extraction (not implemented yet).
//  - BANK: derived from a bank feed/import (not implemented yet).
//  - OTHER: anything not covered above.
enum JournalEntrySourceType {
  MANUAL
  IMPORT
  AI
  BANK
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
  ARCHIVED
}

enum DocumentFileType {
  PDF
  XLSX
  XLS
  CSV
  JPG
  JPEG
  PNG
  WEBP
}

// ------------------------------
// Auth / Identity
// ------------------------------

// A person who can sign in to the internal platform (staff/accountants only —
// clients never get a User record in this system).
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         GlobalRole @default(ACCOUNTANT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships Membership[]

  // Journal entries (Phase 4A-1) this user created. No onDelete cascade —
  // a journal entry must not disappear (or silently orphan) if the user
  // who created it is later removed; application code decides how
  // createdById is displayed (see JournalEntry.createdBy comment below).
  journalEntriesCreated JournalEntry[]
  documentsUploaded Document[]

  @@map("users")
}

// A tenant. All Companies and data must be scoped to an Organization so that
// two organizations can never see each other's data.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  companies   Company[]
  documents   Document[]

  @@map("organizations")
}

// Join table: which users belong to which organization, and with what role
// *within that organization*. Keeping this separate from User.role allows a
// user's permissions to differ per organization later (e.g. an external
// reviewer who is ADMIN in one org and REVIEWER in another).
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           GlobalRole       @default(ACCOUNTANT)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ------------------------------
// Companies (client entities managed inside an Organization)
// ------------------------------

// A "Company" is a client business being bookkept by the organization.
// Clients never log in — this is purely for internal staff to manage.
model Company {
  id             String        @id @default(cuid())
  organizationId String

  // Business information
  legalName       String
  displayName     String
  businessNumber  String?
  address         String?
  city            String?
  stateProvince   String?
  postalCode      String?
  country         String // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU" — kept as a
  // plain code (in addition to the FK below) so filters/sorts/display never
  // require a join, and so the record stays meaningful even if the referenced
  // CountryConfiguration is later deactivated or removed.
  countryConfigurationId String?
  contactEmail           String?
  contactPhone           String?

  // Accounting basics
  currency String // ISO 4217, e.g. "CAD", "USD", "GBP", "AUD"
  status   CompanyStatus @default(ACTIVE)

  // Company Settings → Accounting (Phase 2B-2B-2). Purely a default that
  // pre-fills the frequency selector in the existing "Generate Periods"
  // dialog (src/components/fiscal-years/generate-periods-dialog.tsx) — it
  // does not itself generate anything and does not change how
  // generateAndCreateAccountingPeriods works. A user can still pick the
  // other frequency at generation time.
  defaultPeriodFrequency PeriodFrequency @default(MONTHLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  countryConfiguration CountryConfiguration? @relation(fields: [countryConfigurationId], references: [id])

  fiscalYears       FiscalYear[]
  accountingPeriods AccountingPeriod[]
  accounts          Account[]
  taxCodes          TaxCode[]
  accountMappings   AccountMapping[]
  journalEntries    JournalEntry[]
  documents         Document[]

  @@index([organizationId])
  @@index([countryConfigurationId])
  @@map("companies")
}

// ------------------------------
// Chart of Accounts (Phase 3A-1 — database foundation only, no UI yet)
// ------------------------------

// A single ledger account belonging to a Company (e.g. "1000 Assets",
// "1210 Bank Account A"). This phase only establishes the model, its
// hierarchy, and its constraints — no journal entries, balances, or
// automatic accounting logic post to it yet.
model Account {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?

  // Fixed top-level classification — see the AccountType enum comment.
  type AccountType

  // Finer classification within a type (e.g. "Bank", "Accounts Receivable"
  // under ASSET). Intentionally a plain string rather than an enum: the
  // spec explicitly asks for this not to be "unnecessarily rigid", and the
  // useful subtypes differ by company/industry/country in ways a fixed
  // enum can't accommodate without a migration every time. A curated list
  // of suggested subtypes per AccountType lives in
  // src/accounting/account-subtypes.ts for UI dropdowns to use — that list
  // is guidance, not a DB constraint.
  subtype String?

  // Self-referencing hierarchy: an account may have zero or one parent and
  // any number of children. Application code (src/accounting/accounts.ts)
  // is responsible for rejecting an account being its own parent and for
  // requiring the parent to belong to the same company — both are checks
  // that can't be expressed as a plain foreign key.
  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("AccountHierarchy")

  // Inactive accounts are hidden from normal selection lists but are never
  // deleted (accounting history must stay intact even once an account is
  // retired). No separate AccountStatus enum — a boolean is all this needs
  // and matches how the rest of this phase is scoped (no posting/balance
  // state to track yet).
  isActive Boolean @default(true)

  // Marks accounts the system itself relies on (e.g. Retained Earnings,
  // Opening Balance Equity, Accounts Receivable, Accounts Payable, Current
  // Year Earnings) so later phases can protect them from being renamed,
  // retyped, or deleted. No automatic accounting logic reads/writes this
  // flag yet in this phase — it's just persisted.
  isSystemAccount Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mappings (Phase 3C-1) that route a matched source value to this
  // account. An account is never deleted (isActive above), so this
  // relation doesn't need an onDelete action — nothing here cascades.
  accountMappings AccountMapping[]

  // Journal entry lines (Phase 4A-1) that post to this account. An account
  // is never deleted (isActive above), so this relation doesn't need an
  // onDelete action either — nothing here cascades.
  journalEntryLines JournalEntryLine[]

  // Account code must be unique within a company, but the same code (e.g.
  // "1000") is allowed to repeat across different companies.
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([parentAccountId])
  @@map("accounts")
}

// ------------------------------
// Fiscal Years / Accounting Periods (Phase 2B-1 — backend foundation only)
// ------------------------------

// A company's fiscal year (e.g. "FY2026", Apr 1 2026 → Mar 31 2027). A
// company can have many fiscal years over time, but a given company's
// fiscal years must never overlap in date range — enforced at the
// application level in src/accounting/fiscal-years.ts (see comments there).
model FiscalYear {
  id        String       @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  // Journal entries (Phase 4A-1) posted within this fiscal year. No
  // onDelete cascade here — a fiscal year that already has journal entries
  // shouldn't be deletable out from under them (application code, not this
  // phase, decides how that's enforced).
  journalEntries JournalEntry[]

  // A company shouldn't have two fiscal years with the same name (e.g. two
  // "FY2026"s). Overlap-by-date-range is a separate, non-unique-constraint
  // check performed in application code before create.
  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_years")
}

// A subdivision of a FiscalYear (a month or a quarter, depending on how it
// was generated). companyId is denormalized from the parent FiscalYear
// (rather than derived via a join every time) so every query/index here can
// be scoped directly to a company — the same pattern Company already uses
// for organizationId. It is always set from the fiscal year's own
// companyId server-side, never taken from client input, so the two can
// never disagree.
model AccountingPeriod {
  id           String       @id @default(cuid())
  companyId    String
  fiscalYearId String
  name         String
  periodNumber Int
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  // Journal entries (Phase 4A-1) posted within this period. No onDelete
  // cascade — same rationale as FiscalYear.journalEntries above.
  journalEntries JournalEntry[]

  // Period numbers must be unique within a fiscal year (e.g. only one
  // "Period 1" per fiscal year).
  @@unique([fiscalYearId, periodNumber])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([companyId, startDate, endDate])
  @@map("accounting_periods")
}

// ------------------------------
// Supporting reference data (extendable, not hard-coded business logic)
// ------------------------------

// Reusable country configuration. Lets an ADMIN add supported countries later
// without a code change, and gives future phases (tax engine, fiscal periods,
// reporting) a single place to hang country-specific rules — none of which
// are implemented yet. Only the identity/currency fields are functional in
// Phase 2A; taxSystem / taxAuthority / accountingStandard / dateFormat are
// nullable placeholders for later phases.
model CountryConfiguration {
  id          String @id @default(cuid())
  countryName String
  countryCode String @unique // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU"

  currencyCode   String // ISO 4217, e.g. "CAD"
  currencySymbol String // e.g. "$"

  // Future-use fields — intentionally nullable, not implemented in Phase 2A.
  dateFormat         String?
  taxSystem          String?
  taxAuthority       String?
  accountingStandard String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]

  @@map("country_configurations")
}

// ------------------------------
// Tax Codes (Phase 3B-1 — database foundation only, no UI, no calculation
// engine yet)
// ------------------------------

// A single tax code belonging to a Company (e.g. "HST-ON" / 13% / HST for a
// Canadian company, or "STD" / 20% / VAT for a UK company). This phase only
// establishes the model and its constraints — no tax calculation, filing,
// returns, AI tax decisions, account mapping, or journal entries read/write
// it yet.
//
// countryCode is a plain ISO 3166-1 alpha-2 string (matching the pattern
// already used by Company.country) rather than a required FK to
// CountryConfiguration — the same country can have several tax regimes
// (e.g. Canada: federal GST plus per-province HST/PST), so "which country"
// and "which CountryConfiguration row is currently configured" are kept as
// separate concerns. No rates are seeded or hard-coded anywhere in this
// phase (spec section 5) — every TaxCode row is explicitly created with
// whatever rate/name/method the caller supplies. See
// src/tax/country-tax-guidance.ts for the (non-binding) suggested TaxType
// per supported country used to drive a future "add tax code" form.
model TaxCode {
  id        String @id @default(cuid())
  companyId String

  // ISO 3166-1 alpha-2, e.g. "CA", "US", "GB", "AU" — see the model comment
  // above for why this isn't a required FK.
  countryCode String

  code String
  name String

  taxType           TaxType
  calculationMethod CalculationMethod

  // Percentage rate (e.g. 13.0000 for 13%), stored with enough precision
  // for real-world sub-percent tax rates. Application code (src/tax/tax-
  // codes.ts) enforces the one basic invariant this phase cares about —
  // ZERO_RATE/EXEMPT/OUT_OF_SCOPE codes must be 0, STANDARD_RATE codes must
  // be > 0 — but does not otherwise calculate or apply tax with it yet.
  rate Decimal @db.Decimal(7, 4)

  // Whether the tax this code represents can be recovered/claimed back as
  // an input tax credit (true for most GST/HST/VAT on business purchases,
  // typically false for e.g. US sales tax paid by the end consumer). Purely
  // descriptive metadata in this phase — nothing yet reads it to affect a
  // calculation.
  isRecoverable Boolean @default(true)

  // Inactive tax codes are hidden from normal selection lists but are never
  // deleted, same rationale as Account.isActive: historical transactions
  // that reference a tax code (once that exists in a later phase) must
  // keep working.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mappings (Phase 3C-1) that route a matched source value to this tax
  // code. A tax code is never deleted (isActive above), so this relation
  // doesn't need an onDelete action — nothing here cascades.
  accountMappings AccountMapping[]

  // Tax code must be unique within a company, but the same code (e.g.
  // "STD") is allowed to repeat across different companies — same pattern
  // as Account.code.
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, countryCode])
  @@index([companyId, taxType])
  @@map("tax_codes")
}

// ------------------------------
// Account Mapping (Phase 3C-1 — database foundation only, no UI, no
// automatic matching yet)
// ------------------------------

// A reusable rule that will eventually let a later phase auto-route a real
// transaction (bank line, sales transaction, etc. — none of which exist
// yet) to a chart-of-accounts Account and/or a TaxCode, based on a source
// value such as a bank description, vendor name, customer name, category,
// or transaction type (see MappingSourceType). This phase only stores the
// rule shape and its constraints (spec section 3: "Do not implement
// automatic matching yet") — nothing evaluates sourceValue against a real
// transaction or applies accountId/taxCodeId to anything.
model AccountMapping {
  id        String @id @default(cuid())
  companyId String

  // A human-readable label for the rule (e.g. "Starbucks → Meals &
  // Entertainment"), shown in a future mapping-management UI.
  name String

  // What kind of value sourceValue represents — see the MappingSourceType
  // enum comment above.
  sourceType MappingSourceType

  // The raw value this rule matches against (e.g. "STARBUCKS", a vendor
  // name, a category label). Free-form text: the shape of this value
  // differs by sourceType and by import source, so — like Account.subtype
  // — a fixed enum/format would be too rigid here. No matching logic
  // (exact/fuzzy/regex) is implemented against it in this phase.
  sourceValue String

  // Where a matched transaction should be routed. At least one of
  // accountId / taxCodeId must be set (enforced both by the app layer in
  // src/mapping/account-mappings.ts and by the DB check constraint added
  // in this phase's migration) — a mapping that routes to neither an
  // account nor a tax code does nothing. Both may be set at once (e.g. an
  // expense account and its associated tax code for the same source).
  accountId String?
  taxCodeId String?

  // Lets multiple rules exist for overlapping/ambiguous source values
  // (e.g. a specific vendor rule vs. a broader category fallback) with a
  // defined resolution order for whichever later phase implements the
  // actual matching engine. Higher runs first; plain integer rather than
  // an enum since "how many priority tiers" is a product decision for
  // that later phase, not this one. Not enforced/interpreted by anything
  // in this phase.
  priority Int @default(0)

  // Inactive mappings are hidden from normal selection and are never
  // deleted, same rationale as Account.isActive / TaxCode.isActive —
  // historical use of a rule (once a matching engine exists) must stay
  // auditable.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])
  taxCode TaxCode? @relation(fields: [taxCodeId], references: [id])

  @@index([companyId])
  @@index([companyId, sourceType])
  @@index([companyId, sourceType, sourceValue])
  @@index([companyId, isActive])
  @@index([accountId])
  @@index([taxCodeId])
  @@map("account_mappings")
}

// ------------------------------
// Documents (Phase 4B-1 — intake/storage foundation only)
// ------------------------------


model DocumentProcessingResult {
  id                         String         @id @default(cuid())
  documentId                 String         @unique
  detectedFileType           DocumentFileType
  pageCount                  Int?
  sheetCount                 Int?
  rowCount                   Int?
  columnCount                Int?
  requiresOcr                Boolean        @default(false)
  extractedContentReference  String?
  processingError            String?
  processedAt                DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_processing_results")
}

model Document {
  id               String         @id @default(cuid())
  organizationId   String
  companyId        String
  uploadedById     String
  originalFileName String
  fileType         DocumentFileType
  mimeType         String
  fileSize         BigInt
  storageKey       String         @unique
  documentStatus   DocumentStatus @default(UPLOADED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  processingResult DocumentProcessingResult?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, companyId, createdAt])
  @@index([companyId, documentStatus])
  @@index([uploadedById])
  @@map("documents")
}

// ------------------------------
// Journal Entries (Phase 4A-1 — database foundation only, no UI, no
// automatic posting/numbering/import/AI yet)
// ------------------------------

// The header record for a double-entry journal entry belonging to a
// Company. This phase only establishes the model, its relationships, and
// its basic status/balance/date invariants (spec sections 1–13) — it does
// not implement the entry UI, automatic entry numbering, file
// upload/import, OCR, AI extraction, bank import, general ledger, or
// financial reports (spec section 17). Reusable balance/date validation
// (src/accounting/journal-entries.ts) is meant to be used as-is by the
// Phase 4A-3 UI rather than reimplemented there.
model JournalEntry {
  id                 String                 @id @default(cuid())
  companyId          String
  fiscalYearId       String
  accountingPeriodId String

  // Caller-supplied for now (spec section 10: "do not create a
  // complicated automatic numbering system yet"). Enforced unique within
  // a company by the constraint below; src/accounting/journal-entries.ts
  // is the single place a future auto-numbering scheme would plug in.
  entryNumber String

  entryDate DateTime

  // Free-text metadata (spec section 11), meant to become searchable /
  // filterable once a real Journal Entry list UI exists.
  reference   String?
  description String?
  label       String?

  status JournalEntryStatus @default(DRAFT)

  // Where this entry came from — see the JournalEntrySourceType enum
  // comment. Purely descriptive in this phase.
  sourceType JournalEntrySourceType @default(MANUAL)

  // The user who created this entry (spec section 12). Deliberately not
  // onDelete: Cascade / SetNull — a journal entry's audit trail shouldn't
  // silently lose its author, and users in this system are suspended
  // (UserStatus), not hard-deleted. Application code should select only
  // { id, name } (never passwordHash/email) when exposing this relation,
  // per spec section 12 ("do not expose sensitive user information
  // unnecessarily").
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear       FiscalYear       @relation(fields: [fiscalYearId], references: [id])
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])

  lines JournalEntryLine[]

  // Entry number must be unique within a company (spec section 10), but
  // the same number (e.g. "JE-0001") is allowed to repeat across
  // different companies — same pattern as Account.code / TaxCode.code.
  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([companyId, entryDate])
  @@index([companyId, status])
  @@index([accountingPeriodId])
  @@index([fiscalYearId])
  @@index([createdAt])
  @@map("journal_entries")
}

// A single debit or credit line within a JournalEntry, posting to one
// chart-of-accounts Account. This phase stores the line shape and its
// basic invariants (non-negative amounts, same-company account) only —
// nothing yet posts these amounts to a ledger balance (spec section 17,
// "Do NOT build General Ledger").
model JournalEntryLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String

  description String?
  reference   String?

  // Precise fixed-point decimal, never floating-point (spec section 8).
  // Scale of 4 accommodates currencies/rates with sub-cent precision;
  // application code (src/accounting/journal-entries.ts) enforces >= 0
  // for both fields — negative amounts are represented by using the
  // opposite column, not a negative number (spec section 8).
  debit  Decimal @db.Decimal(19, 4)
  credit Decimal @db.Decimal(19, 4)

  // Explicit display/entry order within the parent JournalEntry (a future
  // UI concern — Phase 4A-3 — but the column belongs here now so line
  // order survives round-trips before that UI exists).
  lineNumber Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  // Deliberately no onDelete override — an Account is never hard-deleted
  // (Account.isActive), so this never needs to cascade or null out; the
  // account referenced by a line must always belong to the same company
  // as the parent JournalEntry, enforced in application code (spec
  // section 5) since Prisma can't express a cross-row "same companyId as
  // my parent" constraint declaratively.
  account Account @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}
